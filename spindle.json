{
  "version": "2.0.0+ko",
  "name": "LumiScript (한국어)",
  "identifier": "lumiscript_ko",
  "author": "mindbound (한국어판: mallang0723)",
  "github": "https://github.com/mallang0723/LumiScript-ko",
  "homepage": "https://github.com/mallang0723/LumiScript-ko",
  "description": "LumiScript(mindbound 원작)의 비공식 한국어판. 채팅 이벤트에 반응하고 동작을 자동화하는 Lumiverse용 JavaScript 스크립트 플랫폼이에요. 원작: https://github.com/mindbound/lumiscript",
  "permissions": [
    "chat_mutation",
    "chats",
    "characters",
    "generation",
    "interceptor",
    "macro_interceptor",
    "cors_proxy",
    "ui_panels",
    "ephemeral_storage",
    "world_books",
    "databanks",
    "personas",
    "presets",
    "regex_scripts",
    "context_handler",
    "tools",
    "push_notification",
    "event_tracking",
    "app_manipulation",
    "images",
    "image_gen",
    "oauth",
    "web_search",
    "memories"
  ],
  "requested_capabilities": [
    "dynamic_code_execution"
  ],
  "entry_backend": "dist/backend.js",
  "entry_frontend": "dist/frontend.js",
  "minimum_lumiverse_version": "1.0.4",
  "interceptorTimeoutMs": 30000
}
